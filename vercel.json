{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": ["gru1"],
  "buildCommand": "mkdir -p public/leads && cp -r src/cmr_leads/web/static public/static && cp -r src/cmr_leads/web/static public/leads/static",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "{src/**,config/**,alembic.ini}"
    }
  },
  "headers": [
    {
      "source": "/(leads/)?static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
