# Base de datos (SQLite local; en el futuro: postgresql+psycopg://user:pass@host/db)
DATABASE_URL=sqlite:///data/cmr_leads.db

# Workspace (cuenta de CMR). Permite múltiples cuentas en el futuro.
WORKSPACE=cmr
DEFAULT_COUNTRY=AR
SCORING_CONFIG=config/scoring.yaml

# Instagram Graph API — Business Discovery (oficial)
# Requiere: cuenta IG profesional vinculada a una página de Facebook + app de Meta.
# Usar preferentemente un token de System User (Business Manager); los tokens de usuario largos vencen a los 60 días.
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
META_GRAPH_API_VERSION=v23.0
# Tope de consultas diarias a Business Discovery (protege el rate limit de la app)
META_MAX_LOOKUPS_PER_DAY=150

# Análisis del sitio web público de cada lead (1 request a la home + robots.txt)
WEBSITE_FETCH_ENABLED=true
WEBSITE_TIMEOUT_SECONDS=10

# Datos para los mensajes
SENDER_NAME=Tomás
COMPANY_NAME=CMR Software Solutions
COMPANY_CITY=San Nicolás

# Fase 2+: GOOGLE_PLACES_API_KEY=
# Fase 3+: ANTHROPIC_API_KEY=
